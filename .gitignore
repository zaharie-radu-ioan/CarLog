# Git ignore rules for the whole repository (frontend, later backend too).
# Patterns without a leading "/" apply in every folder.

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files: real values stay on your machine, the example is committed
.env
.env.*
!.env.example
*.local

# Python (scripts from later stages)
__pycache__/
*.py[cod]
.venv/
venv/

# macOS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
desktop.ini

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Vite cache
.vite/